<Window x:Class="AudioSwitch.Ui.SwitcherPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioSwitch"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-10000"
        Top="-10000"
        Opacity="0"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 列表样式：单行设备 -->
        <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface"
                                Padding="10,8"
                                Background="Transparent"
                                CornerRadius="9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 磁贴样式：Alt+Tab 风格的大卡片 -->
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardSurface"
                                Margin="6"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CardSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="RowPanelTemplate">
            <StackPanel />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="CardPanelTemplate">
            <WrapPanel ItemWidth="196" ItemHeight="128" Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- 设备行 -->
        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="CurrentBar"
                        Grid.Column="0"
                        Width="3"
                        Height="24"
                        Margin="0,0,9,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="1.5"
                        Visibility="Collapsed" />

                <TextBlock x:Name="DeviceIcon"
                           Grid.Column="1"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="18"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Glyph}"
                           Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Column="2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="NameText"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock x:Name="CurrentBadge"
                           Grid.Column="3"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="当前"
                           Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="CurrentBar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DeviceIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 设备磁贴 -->
        <DataTemplate x:Key="CardTemplate">
            <Grid Margin="14,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="DeviceIcon"
                           Grid.Row="0"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="24"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Glyph}"
                           Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVisibility}}" />

                <Border x:Name="CurrentBadge"
                        Grid.Row="0"
                        Padding="7,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="当前" />
                </Border>

                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock x:Name="NameText"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DeviceIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="12"
            Background="{DynamicResource PopupBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Effect="{StaticResource PopupShadow}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="14" />
        </Border.RenderTransform>

        <Grid>
            <!-- 背景图片与可读性遮罩 -->
            <Rectangle x:Name="BackgroundImageLayer"
                       RadiusX="19"
                       RadiusY="19"
                       Fill="{DynamicResource BackgroundImageBrush}"
                       IsHitTestVisible="False" />
            <Rectangle x:Name="ScrimLayer"
                       RadiusX="19"
                       RadiusY="19"
                       Fill="{DynamicResource ScrimBrush}"
                       IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Margin="20,14,12,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="输出设备"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="DeviceCountText"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Opacity="0.7" />
                    </StackPanel>
                    <TextBlock x:Name="KeyHintText"
                               Grid.Column="1"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.75" />
                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Content="&#xE72C;"
                            ToolTip="重新扫描设备"
                            Click="RefreshButton_Click" />
                </Grid>

                <!-- 设备列表 / 磁贴 -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="DeviceList"
                             Margin="12,4,12,6"
                             MaxHeight="440"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource CardItemStyle}"
                             ItemTemplate="{StaticResource CardTemplate}"
                             ItemsPanel="{StaticResource CardPanelTemplate}"
                             PreviewMouseLeftButtonUp="DeviceList_PreviewMouseLeftButtonUp" />

                    <TextBlock x:Name="EmptyState"
                               Margin="20,24,20,28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="没有找到可用的输出设备"
                               TextAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <!-- 错误提示 -->
                <TextBlock x:Name="ErrorText"
                           Grid.Row="2"
                           Margin="20,0,20,8"
                           FontSize="11"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- 底部操作 -->
                <Border Grid.Row="3"
                        Padding="10,6"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="SettingsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Text="&#xE713;" />
                                    <TextBlock VerticalAlignment="Center" Text="设置" />
                                </StackPanel>
                            </Button>
                            <Button Margin="2,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Click="SoundSettingsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Text="&#xE767;" />
                                    <TextBlock VerticalAlignment="Center" Text="系统声音" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}"
                                Click="ExitButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Text="&#xE7E8;" />
                                <TextBlock VerticalAlignment="Center" Text="退出" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
