<Window x:Class="AudioSwitch.Ui.VolumePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioSwitch 音量"
        Width="480"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-10000"
        Top="-10000"
        Opacity="0"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <DataTemplate x:Key="SessionTemplate">
            <Border Padding="8,6" Background="Transparent" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="30"
                                Height="30"
                                Margin="0,0,10,0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="8">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Glyph}" />
                                <Image Width="20"
                                       Height="20"
                                       Source="{Binding Icon}"
                                       Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Subtitle}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Width="34"
                                   Margin="6,0,2,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding PercentText}"
                                   TextAlignment="Right" />

                        <Button Grid.Column="4"
                                Width="28"
                                Height="28"
                                Click="SessionMute_Click"
                                Style="{StaticResource IconButton}"
                                ToolTip="静音 / 取消静音">
                            <TextBlock FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       Text="{Binding MuteGlyph}" />
                        </Button>
                    </Grid>

                    <Slider Grid.Row="1"
                            Margin="0,3,0,0"
                            Minimum="0"
                            Maximum="100"
                            PreviewMouseLeftButtonDown="SessionSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SessionSlider_PreviewMouseLeftButtonUp"
                            Style="{StaticResource VolumeSlider}"
                            Value="{Binding Volume, Mode=TwoWay}"
                            ValueChanged="SessionSlider_ValueChanged" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="12"
            Background="{DynamicResource PopupBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Effect="{StaticResource PopupShadow}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="14" />
        </Border.RenderTransform>

        <Grid>
            <Rectangle x:Name="BackgroundImageLayer"
                       RadiusX="19"
                       RadiusY="19"
                       Fill="{DynamicResource BackgroundImageBrush}"
                       IsHitTestVisible="False" />
            <Rectangle x:Name="ScrimLayer"
                       RadiusX="19"
                       RadiusY="19"
                       Fill="{DynamicResource ScrimBrush}"
                       IsHitTestVisible="False" />

            <Grid Margin="18,14,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Grid Grid.Row="0" Margin="2,0,2,0">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="音量" />
                        <TextBlock x:Name="DeviceText"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.7"
                               Text="Esc 关闭" />
                </Grid>

                <!-- 总音量 -->
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="12,10"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Click="MasterMute_Click"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="静音 / 取消静音">
                                <TextBlock x:Name="MasterMuteGlyph"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="17"
                                           Text="&#xE767;" />
                            </Button>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="总音量" />
                                <TextBlock x:Name="MasterStatusText"
                                           Margin="0,1,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="默认输出设备" />
                            </StackPanel>

                            <TextBlock x:Name="MasterPercentText"
                                       Grid.Column="2"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="100%" />
                        </Grid>

                        <Slider x:Name="MasterSlider"
                                Grid.Row="1"
                                Margin="2,6,2,0"
                                Minimum="0"
                                Maximum="100"
                                PreviewMouseLeftButtonDown="MasterSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="MasterSlider_PreviewMouseLeftButtonUp"
                                Style="{StaticResource VolumeSlider}"
                                ValueChanged="MasterSlider_ValueChanged" />
                    </Grid>
                </Border>

                <!-- 应用列表 -->
                <Grid Grid.Row="2" Margin="0,12,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="应用程序" />
                        <TextBlock x:Name="SessionCountText"
                                   Margin="7,0,0,0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Opacity="0.7" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconButton}"
                            ToolTip="刷新应用列表"
                            Click="RefreshButton_Click"
                            Content="&#xE72C;" />
                </Grid>

                <ScrollViewer Grid.Row="3"
                              MaxHeight="320"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SessionList" ItemTemplate="{StaticResource SessionTemplate}" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Grid.Row="4"
                           Margin="0,18,0,16"
                           HorizontalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="当前没有正在播放声音的应用"
                           Visibility="Collapsed" />

                <TextBlock x:Name="ErrorText"
                           Grid.Row="4"
                           Margin="0,8,0,4"
                           FontSize="11"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- 底栏 -->
                <Border Grid.Row="5"
                        Margin="0,8,0,0"
                        Padding="0,8,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="SettingsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Text="&#xE713;" />
                                    <TextBlock VerticalAlignment="Center" Text="设置" />
                                </StackPanel>
                            </Button>
                            <Button Margin="2,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Click="SoundSettingsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Text="&#xE767;" />
                                    <TextBlock VerticalAlignment="Center" Text="系统声音" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}"
                                Click="CloseButton_Click"
                                Content="关闭" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
